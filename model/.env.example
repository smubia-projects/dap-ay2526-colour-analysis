# Backend (HF Space) configuration — copy to .env for local dev.
# Model weights live on HF Hub; set the repo so app.py downloads them at startup.
MODEL_REPO_ID=smubiainfrastructure/dap-ay2526-colour-analysis-model
MODEL_FILENAME=farl_classifier.pt

# Local fallback when MODEL_REPO_ID is unset (used during local dev only)
MODEL_PATH=checkpoints/farl_classifier.pt

# CORS — comma-separated origins. Use * for local dev, the Vercel URL in prod.
ALLOWED_ORIGINS=*

# Rate limiting (anti-spam). Leave Upstash vars empty to disable locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PREDICT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
